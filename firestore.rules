rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {

    // Default deny catch-all
    match /{document=**} {
      allow read, write: if false;
    }

    function isValidId(id) {
      return id is string && id.size() <= 128 && id.matches('^[a-zA-Z0-9_\\-]+$');
    }

    function incoming() {
      return request.resource.data;
    }

    function existing() {
      return resource.data;
    }

    function isSignedIn() {
      return request.auth != null;
    }

    // Trusted Administrator check: either bootstrapped admin email or verified in admins collection
    function isAdmin() {
      return isSignedIn() && (
        request.auth.token.email == 'ps1373157@gmail.com' ||
        exists(/databases/$(database)/documents/admins/$(request.auth.uid))
      );
    }

    // Approved member check: strictly verified in Firestore members collection with isApproved == true
    function isApprovedMember(uid) {
      return isSignedIn() && (
        isAdmin() ||
        (exists(/databases/$(database)/documents/members/$(uid)) &&
         get(/databases/$(database)/documents/members/$(uid)).data.isApproved == true)
      );
    }

    function isCurrentApprovedMember() {
      return isApprovedMember(request.auth.uid);
    }

    // Admins collection: read restricted to authenticated users; write restricted to admin
    match /admins/{adminId} {
      allow get: if isSignedIn();
      allow list: if isAdmin();
      allow write: if request.auth.token.email == 'ps1373157@gmail.com';
    }

    // Members collection
    match /members/{userId} {
      allow get: if isSignedIn() && isValidId(userId);
      allow list: if isSignedIn();
      // On registration, a user can only create their own member record with isApproved: false and role: 'member'
      allow create: if isSignedIn() && isValidId(userId) && request.auth.uid == userId && (
        (request.auth.token.email == 'ps1373157@gmail.com' && incoming().uid == userId && incoming().isApproved == true && incoming().role == 'admin') ||
        (request.auth.token.email != 'ps1373157@gmail.com' && incoming().uid == userId && incoming().isApproved == false && incoming().role == 'member')
      );
      // Updates: only the admin can change isApproved or role; regular members can only update profile details
      allow update: if isSignedIn() && isValidId(userId) && (
        isAdmin() ||
        (request.auth.uid == userId &&
         incoming().diff(existing()).affectedKeys().hasOnly(['displayName', 'avatarUrl', 'flowerTag', 'bio', 'updatedAt']) &&
         incoming().uid == existing().uid &&
         incoming().isApproved == existing().isApproved &&
         incoming().role == existing().role)
      );
      allow delete: if isAdmin();
    }

    // Friendship Wall Posts: only approved members can read, create, and react
    match /wall_posts/{postId} {
      allow get, list: if isSignedIn() && isCurrentApprovedMember();
      allow create: if isSignedIn() && isValidId(postId) && isCurrentApprovedMember() &&
        incoming().authorId == request.auth.uid &&
        incoming().likesCount == 0 &&
        incoming().likedBy.size() == 0 &&
        incoming().content is string &&
        incoming().content.size() >= 1 &&
        incoming().content.size() <= 2000;
      allow update: if isSignedIn() && isValidId(postId) && isCurrentApprovedMember() && (
        // Action 1: Like/heart toggle by approved member (only affects likesCount, likedBy, updatedAt)
        (incoming().diff(existing()).affectedKeys().hasOnly(['likesCount', 'likedBy', 'updatedAt']) &&
         incoming().authorId == existing().authorId &&
         incoming().content == existing().content &&
         incoming().likesCount >= 0) ||
        // Action 2: Author edits own post content
        (existing().authorId == request.auth.uid &&
         incoming().authorId == request.auth.uid &&
         incoming().diff(existing()).affectedKeys().hasOnly(['content', 'flowerSticker', 'updatedAt']) &&
         incoming().content is string &&
         incoming().content.size() >= 1 &&
         incoming().content.size() <= 2000)
      );
      allow delete: if isSignedIn() && isValidId(postId) && (existing().authorId == request.auth.uid || isAdmin());
    }

    // Conversations: Group and Private isolation
    match /conversations/{conversationId} {
      // Group conversation
      allow get: if isSignedIn() && (
        (conversationId == 'group_triobloom' && isCurrentApprovedMember()) ||
        (conversationId != 'group_triobloom' && request.auth.uid in resource.data.participantIds) ||
        isAdmin()
      );
      allow list: if isSignedIn() && (
        isAdmin() ||
        (resource.data.type == 'group' && isCurrentApprovedMember()) ||
        (resource.data.type == 'private' && request.auth.uid in resource.data.participantIds)
      );
      allow create: if isSignedIn() && isValidId(conversationId) && isCurrentApprovedMember() && (
        (conversationId == 'group_triobloom' && incoming().type == 'group') ||
        (conversationId != 'group_triobloom' && incoming().type == 'private' &&
         incoming().participantIds.size() == 2 &&
         request.auth.uid in incoming().participantIds)
      );
      allow update: if isSignedIn() && isValidId(conversationId) && (
        isAdmin() ||
        (conversationId == 'group_triobloom' && isCurrentApprovedMember()) ||
        (conversationId != 'group_triobloom' && request.auth.uid in existing().participantIds)
      ) && incoming().diff(existing()).affectedKeys().hasOnly(['lastMessage', 'lastMessageSender', 'lastMessageAt', 'updatedAt']);
      allow delete: if isAdmin();

      // Nested chat messages: strictly isolated to conversation members
      match /messages/{messageId} {
        allow get, list: if isSignedIn() && isValidId(messageId) && (
          isAdmin() ||
          (conversationId == 'group_triobloom' && isCurrentApprovedMember()) ||
          (conversationId != 'group_triobloom' && request.auth.uid in get(/databases/$(database)/documents/conversations/$(conversationId)).data.participantIds)
        );
        allow create: if isSignedIn() && isValidId(messageId) &&
          incoming().senderId == request.auth.uid &&
          incoming().text is string &&
          incoming().text.size() >= 1 &&
          incoming().text.size() <= 1000 && (
            (conversationId == 'group_triobloom' && isCurrentApprovedMember()) ||
            (conversationId != 'group_triobloom' && request.auth.uid in get(/databases/$(database)/documents/conversations/$(conversationId)).data.participantIds)
          );
        allow update: if isSignedIn() && isValidId(messageId) &&
          incoming().diff(existing()).affectedKeys().hasOnly(['readBy']) && (
            isAdmin() ||
            (conversationId == 'group_triobloom' && isCurrentApprovedMember()) ||
            (conversationId != 'group_triobloom' && request.auth.uid in get(/databases/$(database)/documents/conversations/$(conversationId)).data.participantIds)
          );
        allow delete: if isSignedIn() && isValidId(messageId) && (
          existing().senderId == request.auth.uid || isAdmin()
        );
      }
    }

    // Quiz Scores: only approved members can read and create; user ID must match auth UID
    match /quiz_scores/{scoreId} {
      allow get, list: if isSignedIn() && isCurrentApprovedMember();
      allow create: if isSignedIn() && isValidId(scoreId) && isCurrentApprovedMember() &&
        incoming().userId == request.auth.uid &&
        incoming().score is number &&
        incoming().total is number;
      allow update, delete: if isAdmin();
    }
  }
}
