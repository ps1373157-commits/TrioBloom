rules_version = '2';
service firebase.storage {
  match /b/{bucket}/o {

    // Default deny catch-all
    match /{allPaths=**} {
      allow read, write: if false;
    }

    function isSignedIn() {
      return request.auth != null;
    }

    function isAdmin() {
      return isSignedIn() && request.auth.token.email == 'ps1373157@gmail.com';
    }

    function isValidImage() {
      return request.resource.size <= 10 * 1024 * 1024 &&
             request.resource.contentType.matches('image/(jpeg|jpg|png|webp|heic)');
    }

    // Photo Wall uploads: strictly organized by user UID
    match /photos/{userId}/{fileName} {
      allow read: if isSignedIn();
      allow write: if isSignedIn() && request.auth.uid == userId && isValidImage();
      allow delete: if isSignedIn() && (request.auth.uid == userId || isAdmin());
    }

    // Chat attachments: organized by conversation and sender UID
    match /chat/{conversationId}/{userId}/{fileName} {
      allow read: if isSignedIn();
      allow write: if isSignedIn() && request.auth.uid == userId && isValidImage();
      allow delete: if isSignedIn() && (request.auth.uid == userId || isAdmin());
    }
  }
}
